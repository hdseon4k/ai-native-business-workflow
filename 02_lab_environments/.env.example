# ==============================================================================
# AI Native Business Workflow - 로컬 실습 환경 환경 변수 설정 템플릿
# 복사하여 .env 파일을 생성한 후 사용하십시오:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL (pgvector) 설정
# ------------------------------------------------------------------------------
POSTGRES_USER=itsm_admin
POSTGRES_PASSWORD=itsm_secure_password_2026!
POSTGRES_DB=itsm_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# ------------------------------------------------------------------------------
# 2. n8n 워크플로우 엔진 설정
# ------------------------------------------------------------------------------
# n8n 자격증명 암호화 키 (32자 이상 랜덤 문자열 권장)
N8N_ENCRYPTION_KEY=clo_ai_native_workflow_super_secret_encryption_key_2026_x89f

# n8n 호스트 및 웹훅 URL (로컬 실습 기준)
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

# 타임존 및 시스템 설정
GENERIC_TIMEZONE=Asia/Seoul
TZ=Asia/Seoul
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# 텔레메트리 비활성화 (폐쇄망 환경 모사)
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false

# ------------------------------------------------------------------------------
# 3. Ollama 온프레미스 sLM 추론 설정
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PORT=11434

# 1~5주차 실습용 표준 모델
# 채팅/추론: Qwen 2.5 7B Instruct (Q4_K_M 양자화 권장, VRAM 약 4.8GB)
OLLAMA_CHAT_MODEL=qwen2.5:7b
# 임베딩: BAAI bge-m3 다국어 1024차원 임베딩 (VRAM 약 1.2GB)
OLLAMA_EMBED_MODEL=bge-m3

# ------------------------------------------------------------------------------
# 4. Qdrant 벡터 데이터베이스 설정
# ------------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ------------------------------------------------------------------------------
# 5. 사내 Mock Enterprise API 설정 (FastAPI)
# ------------------------------------------------------------------------------
MOCK_API_HOST=mock-enterprise-api
MOCK_API_PORT=8000
